# העתיקו את הקובץ הזה ל-.env ומלאו את המפתחות. אל תשתפו את .env עם אף אחד.

# מנועי AI — כל מנוע שיש לו מפתח יופעל
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# אילו מנועים רצים בבדיקה החינמית באתר (השאר מוצעים בשיחה)
PUBLIC_ENGINES=chatgpt

# כמה פעמים כל שאלה רצה בכל מנוע (התשובות משתנות בין הרצות)
AI_RUNS=2

# כפתור ההמשך בסוף הדוח (וואטסאפ / Calendly)
CTA_URL=https://wa.me/972XXXXXXXXX
CTA_TEXT=לקביעת שיחה

# אופציונלי: Webhook של Make לשליחת כל ליד (למייל / גיליון / CRM)
LEAD_WEBHOOK_URL=

# מגבלות שימוש יומיות
MAX_PER_IP=3
MAX_PER_DOMAIN=2
MAX_PER_EMAIL=2

# מודלים (אפשר להשאיר כמו שזה)
OPENAI_MODEL=gpt-4.1-mini
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# 1 = לטעון את האתר בדפדפן כדי להשוות לתוכן שבוטים רואים (מומלץ)
RENDER_JS=1
